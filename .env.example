# Copie ce fichier en .env pour le developpement local (`vercel dev`).
# En production, ces valeurs vivent dans Vercel > Settings > Environment Variables.
# Aucune d'entre elles n'est jamais envoyee au navigateur.

# --- Porte d'entree de l'application -----------------------------------------
# Cle de signature des cookies de session. 32 caracteres minimum.
# Genere-la avec :  openssl rand -base64 48
SESSION_SECRET=

# Un code d'acces par personne : "prenom:code:role", separes par des virgules.
# Roles : "admin" (tout) ou "membre" (dispos et sondage uniquement, defaut).
# Revoquer un collegue = retirer sa ligne et redeployer.
HOMESMASH_ACCESS_CODES=benjamin:remplace-moi-par-un-code-long:admin,collegue:un-autre-code-long

# --- Compte Doinsport (celui qui peut reserver) -------------------------------
DOINSPORT_LOGIN=0612345678
DOINSPORT_PASSWORD=
DOINSPORT_CLUB_ID=f520b68c-d5dd-4fd2-84b0-3e0742a771a2
DOINSPORT_ACTIVITY_ID=541b8d8a-3ce2-4f46-913c-5e6e4d9b5dea
DOINSPORT_CATEGORY_ID=190e89c2-98a1-4f3b-a23d-df5c921e9324
# Facultatif : identifiant white-label du club, deja renseigne par defaut.
# DOINSPORT_WHITE_LABEL_ID=802abea3-acbe-4f4f-aec7-3e36ee18a0e5

# --- Google Chat ---------------------------------------------------------------
GOOGLE_CHAT_WEBHOOK_PROD=
GOOGLE_CHAT_WEBHOOK_TEST=

# --- Facultatif : Upstash Redis ------------------------------------------------
# Sans lui, la limitation de debit reste locale a chaque instance serverless.
# Vercel > Storage > Upstash for Redis renseigne ces deux variables tout seul.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
